rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveMember() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.statut == 'actif';
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Profils utilisateurs
    // - lecture : son propre profil, ou tout profil pour un membre actif / un admin
    // - création : uniquement en statut "en_attente" avec le rôle "member"
    // - modification : le membre ne peut pas changer son statut ni son rôle (seul un admin le peut)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isActiveMember() || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.statut == 'en_attente' &&
        request.resource.data.role == 'member';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          request.resource.data.statut == resource.data.statut &&
          request.resource.data.role == resource.data.role) ||
        isAdmin());
      allow delete: if isAdmin();
    }

    // Entreprises & Restaurants : lecture publique, écriture par le propriétaire ou admin
    // Fiches de l'annuaire : lecture par les membres actifs, écriture par les administrateurs
    match /fiches/{ficheId} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
      // un membre peut modifier sa propre fiche (reliée à son compte), sans toucher aux numéros ni au lien
      allow update: if isActiveMember() && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['nom', 'prenom', 'email', 'ville', 'activite', 'competences', 'anciennete', 'reseaux',
           'attentes', 'info', 'pays', 'presentation', 'logo', 'photo', 'statutFiche', 'aConfirmer',
           'cherche', 'propose', 'tags', 'majLe']);
    }

    // Entreprises des membres (5 maximum par membre, contrôlé par l'application) : membres actifs uniquement
    match /entreprises/{entId} {
      allow read: if isAdmin() || (isActiveMember() &&
        (resource.data.statut == 'publie' || resource.data.ownerUid == request.auth.uid));
      allow create: if isAdmin() || (isActiveMember() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.statut == 'publie');
      allow update: if isAdmin() || (isActiveMember() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      // photos de l'entreprise, rangées à part pour garder les listes légères
      match /medias/{mediaId} {
        allow read: if isActiveMember();
        allow write: if isAdmin() || (isActiveMember() &&
          get(/databases/$(database)/documents/entreprises/$(entId)).data.ownerUid == request.auth.uid);
      }
    }

    // Prestataires recommandés (coiffeur, couturier, plombier…) avec notes et commentaires
    match /prestataires/{pid} {
      allow read: if isActiveMember();
      // un membre crée une recommandation "en_attente" ; un admin peut la publier directement
      allow create: if isActiveMember() && request.resource.data.ownerUid == request.auth.uid &&
        (isAdmin() || request.resource.data.statut == 'en_attente');
      allow update: if isAdmin() ||
        (isActiveMember() && resource.data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.get('statut', 'valide') == resource.data.get('statut', 'valide')) ||
        (isActiveMember() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nbAvis', 'sommeNotes']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /avis/{avisId} {
        allow read: if isActiveMember();
        allow create, update: if isActiveMember() && request.auth.uid == avisId &&
          request.resource.data.uid == request.auth.uid;
        allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == avisId);
      }
    }

    // Demandes « je cherche / je propose » et leurs réponses : membres actifs uniquement
    match /demandes/{did} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.auteurUid == request.auth.uid &&
        request.resource.data.statut == 'ouverte';
      allow update: if isAdmin() ||
        (isActiveMember() && resource.data.auteurUid == request.auth.uid &&
          request.resource.data.auteurUid == resource.data.auteurUid) ||
        (isActiveMember() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nbReponses']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.auteurUid == request.auth.uid);

      match /reponses/{rid} {
        allow read: if isActiveMember();
        allow create: if isActiveMember() && request.resource.data.auteurUid == request.auth.uid;
        allow delete: if isAdmin() || (isSignedIn() && resource.data.auteurUid == request.auth.uid);
      }
    }

    // Voyageurs & bagages : annonces des membres (kilos / valises), lecture réservée aux membres actifs
    match /voyages/{vid} {
      allow read: if isActiveMember();
      // kilos / valises et demandes d'accompagnement : publiés tout de suite ;
      // offres pour accompagner : "en_attente" jusqu'à validation par un administrateur
      allow create: if isActiveMember() && request.resource.data.ownerUid == request.auth.uid &&
        (isAdmin() ||
          request.resource.data.get('statut', 'valide') == 'en_attente' ||
          request.resource.data.get('typeAnnonce', 'kilos') != 'accompagnateur');
      allow update: if isAdmin() || (isActiveMember() && resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.get('statut', 'valide') == resource.data.get('statut', 'valide'));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Fil d'actualité : tout membre actif peut publier (texte, photos, liens) ; publication visible après validation par un administrateur.
    match /fil/{fid} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.ownerUid == request.auth.uid &&
        (isAdmin() || request.resource.data.get('statut', 'en_attente') == 'en_attente');
      allow update: if isAdmin() ||
        (isActiveMember() && resource.data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.get('statut', 'en_attente') == resource.data.get('statut', 'en_attente')) ||
        (isActiveMember() && resource.data.get('statut', 'en_attente') == 'valide' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aimes']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /medias/{mediaId} {
        allow read: if isActiveMember();
        allow write: if isAdmin() || (isActiveMember() &&
          get(/databases/$(database)/documents/fil/$(fid)).data.ownerUid == request.auth.uid);
      }
    }

    // Loisirs : bonnes adresses, sorties, liens vidéo et photos (rangées dans "medias")
    match /loisirs/{lid} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (isActiveMember() && resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /medias/{mediaId} {
        allow read: if isActiveMember();
        allow write: if isAdmin() || (isActiveMember() &&
          get(/databases/$(database)/documents/loisirs/$(lid)).data.ownerUid == request.auth.uid);
      }
    }

    // Immobilier : annonces des membres (location, court séjour, vente, recherche), validées par un administrateur
    match /immobilier/{iid} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.ownerUid == request.auth.uid &&
        (isAdmin() || request.resource.data.get('statut', 'en_attente') == 'en_attente');
      allow update: if isAdmin() || (isActiveMember() && resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.get('statut', 'en_attente') == resource.data.get('statut', 'en_attente'));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /medias/{mediaId} {
        allow read: if isActiveMember();
        allow write: if isAdmin() || (isActiveMember() &&
          get(/databases/$(database)/documents/immobilier/$(iid)).data.ownerUid == request.auth.uid);
      }
    }

    // Restaurants : fiches et menus gérés par les restaurateurs (validés par un administrateur), avis des membres
    match /restos/{rid} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.ownerUid == request.auth.uid &&
        (isAdmin() || request.resource.data.get('statut', 'en_attente') == 'en_attente');
      allow update: if isAdmin() ||
        (isActiveMember() && resource.data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.get('statut', 'en_attente') == resource.data.get('statut', 'en_attente')) ||
        (isActiveMember() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nbAvis', 'sommeNotes']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /avis/{avisId} {
        allow read: if isActiveMember();
        allow create, update: if isActiveMember() && request.auth.uid == avisId &&
          request.resource.data.uid == request.auth.uid;
        allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == avisId);
      }

      match /medias/{mediaId} {
        allow read: if isActiveMember();
        allow write: if isAdmin() || (isActiveMember() &&
          get(/databases/$(database)/documents/restos/$(rid)).data.ownerUid == request.auth.uid);
      }
    }

    // Entraide & solidarité : pages d'associations et de collectifs (un administrateur par page, validé par RRTE)
    match /structures/{sid} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.ownerUid == request.auth.uid &&
        (isAdmin() || request.resource.data.get('statut', 'en_attente') == 'en_attente');
      allow update: if isAdmin() ||
        (isActiveMember() && resource.data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.get('statut', 'en_attente') == resource.data.get('statut', 'en_attente'));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /publications/{pid} {
        allow read: if isActiveMember();
        allow create, update, delete: if isAdmin() || (isActiveMember() &&
          get(/databases/$(database)/documents/structures/$(sid)).data.ownerUid == request.auth.uid &&
          get(/databases/$(database)/documents/structures/$(sid)).data.get('statut', 'en_attente') == 'valide');
      }

      match /medias/{mediaId} {
        allow read: if isActiveMember();
        allow write: if isAdmin() || (isActiveMember() &&
          get(/databases/$(database)/documents/structures/$(sid)).data.ownerUid == request.auth.uid);
      }
    }

    // Initiatives des membres : proposées par tout membre actif, publiées après validation d'un administrateur
    match /initiatives/{iid} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.ownerUid == request.auth.uid &&
        (isAdmin() || request.resource.data.get('statut', 'en_attente') == 'en_attente');
      allow update: if isAdmin() || (isActiveMember() && resource.data.ownerUid == request.auth.uid &&
        resource.data.get('statut', 'en_attente') == 'en_attente' && request.resource.data.get('statut', 'en_attente') == 'en_attente' &&
        request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Besoins & urgences (avec date limite) : proposés par tout membre actif, publiés après validation ; l'auteur peut les marquer « terminés »
    match /besoins/{bid} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.ownerUid == request.auth.uid &&
        (isAdmin() || request.resource.data.get('statut', 'en_attente') == 'en_attente');
      allow update: if isAdmin() ||
        (isActiveMember() && resource.data.ownerUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolu'])) ||
        (isActiveMember() && resource.data.ownerUid == request.auth.uid &&
          resource.data.get('statut', 'en_attente') == 'en_attente' &&
          request.resource.data.get('statut', 'en_attente') == 'en_attente' &&
          request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Démarches & papiers : guides partagés (état civil, passeport, visas…), relus par un administrateur
    match /demarches/{did} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.ownerUid == request.auth.uid &&
        (isAdmin() || request.resource.data.statut == 'en_attente');
      allow update: if isAdmin() || (isActiveMember() && resource.data.ownerUid == request.auth.uid &&
        resource.data.statut == 'en_attente' && request.resource.data.statut == 'en_attente' &&
        request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Signalements de comportements : un membre actif peut en créer (un par cible), seuls les administrateurs les lisent
    match /signalements/{sid} {
      allow create: if isActiveMember() && request.resource.data.auteurUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /businesses/{bizId} {
      allow read: if true;
      allow create: if isActiveMember();
      allow update, delete: if isSignedIn() &&
        (resource.data.owner_uid == request.auth.uid || isAdmin());
    }

    match /restaurants/{restId} {
      allow read: if true;
      allow create: if isActiveMember();
      allow update, delete: if isSignedIn() &&
        (resource.data.owner_uid == request.auth.uid || isAdmin());
    }

    // Événements : lecture réservée aux membres actifs, création/suppression par les admins,
    // inscription : un membre actif peut modifier uniquement la liste "attendees"
    match /events/{eventId} {
      allow read: if isActiveMember();
      // événements RRTE : créés par les administrateurs ; événements entre membres : proposés par un membre
      // actif (en attente de validation, sauf si c'est un administrateur)
      allow create: if isAdmin() || (isActiveMember() &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.categorie == 'membres' &&
        request.resource.data.statut == 'en_attente');
      allow update: if isAdmin() ||
        (isActiveMember() && resource.data.created_by == request.auth.uid &&
          resource.data.get('statut', 'valide') == 'en_attente' && request.resource.data.statut == 'en_attente' &&
          request.resource.data.created_by == resource.data.created_by) ||
        (isActiveMember() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.created_by == request.auth.uid);

      match /medias/{mediaId} {
        allow read: if isActiveMember();
        allow write: if isAdmin() || (isActiveMember() &&
          get(/databases/$(database)/documents/events/$(eventId)).data.created_by == request.auth.uid);
        // photos de la galerie ajoutées par les membres (une photo allégée, moins de 400 Ko)
        allow create: if isActiveMember() && request.resource.data.kind == 'galerie' &&
          request.resource.data.auteurUid == request.auth.uid && request.resource.data.data.size() < 400000;
        allow delete: if isActiveMember() && resource.data.get('auteurUid', '') == request.auth.uid;
      }
    }

    // Offres d'emploi / Services B2B : réservé aux membres actifs
    match /job_listings/{jobId} {
      allow read, create: if isActiveMember();
      allow update, delete: if isSignedIn() &&
        (resource.data.posted_by == request.auth.uid || isAdmin());
    }

    match /services/{serviceId} {
      allow read, create: if isActiveMember();
      allow update, delete: if isSignedIn() &&
        (resource.data.offered_by == request.auth.uid || isAdmin());
    }

    // Avis / commentaires : lecture réservée aux membres pour l'instant
    match /reviews/{reviewId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember();
      allow update, delete: if isSignedIn() &&
        (resource.data.author_uid == request.auth.uid || isAdmin());
    }

    // Vidéos : visibles une fois approuvées, modération admin
    match /videos/{videoId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isActiveMember();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Logs admin : réservé aux admins
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ---------------- Caisse solidaire ----------------
    // Équipe de la caisse : un document par personne (rôle « tresorier » ou « controleur »), géré par les administrateurs.
    function estEquipeCaisse() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/caisse_tresoriers/$(request.auth.uid));
    }
    function gereCaisse() {
      return isAdmin() || (estEquipeCaisse() &&
        get(/databases/$(database)/documents/caisse_tresoriers/$(request.auth.uid)).data.role == 'tresorier');
    }
    function voitCaisse() {
      return isAdmin() || estEquipeCaisse();
    }

    match /caisse_tresoriers/{tid} {
      allow read: if isActiveMember() || isAdmin();
      allow write: if isAdmin();
    }

    // Paiements envoyés par les membres (avec capture d'écran) : visibles du membre concerné et de l'équipe seulement
    match /cotisations/{cid} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || voitCaisse());
      allow create: if isActiveMember() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.statut == 'en_attente' &&
        request.resource.data.nbMois is int && request.resource.data.nbMois >= 1 && request.resource.data.nbMois <= 12 &&
        request.resource.data.montant == 2000 * request.resource.data.nbMois &&
        request.resource.data.capture.size() < 800000;
      allow update: if gereCaisse();
      allow delete: if gereCaisse() ||
        (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.statut == 'en_attente');
    }

    // Liste des cotisants, totaux et dépenses : lisibles par tous les membres actifs ; écriture par la trésorerie
    match /cotisants/{kid} {
      allow read: if isActiveMember() || voitCaisse();
      allow write: if gereCaisse();
    }
    match /caisse_totaux/{tid} {
      allow read: if isActiveMember() || voitCaisse();
      allow write: if voitCaisse();
    }
    // Dépenses : créées et annulées par la trésorerie ; une dépense importante ne devient valide que si une AUTRE personne de l'équipe l'approuve
    match /depenses/{did} {
      allow read: if isActiveMember() || voitCaisse();
      allow create, delete: if gereCaisse();
      allow update: if voitCaisse() && (
        (resource.data.statut == 'a_approuver' && request.resource.data.statut == 'validee' &&
          resource.data.saisiUid != request.auth.uid) ||
        (gereCaisse() && request.resource.data.annulee == true) ||
        (gereCaisse() && request.resource.data.statut == resource.data.statut));
    }
    // Rapprochements : le solde réel constaté sur le compte Orange Money, comparé au solde calculé. Jamais modifiés.
    // Dons et sponsoring : le nom affiché est « Anonyme » si le donateur le souhaite (le vrai nom reste dans le journal). Annulation possible, jamais de suppression.
    match /dons/{donid} {
      allow read: if isActiveMember() || voitCaisse();
      allow create: if gereCaisse() && request.resource.data.montant is int && request.resource.data.montant > 0;
      allow update: if gereCaisse() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['annulee', 'motifAnnulation', 'annuleLe']);
      allow delete: if false;
    }
    match /rapprochements/{rid} {
      allow read: if voitCaisse();
      allow create: if voitCaisse();
      allow update, delete: if false;
    }
    // Journal de la caisse : on ajoute des lignes, jamais de modification ni de suppression
    match /journal/{jid} {
      allow read: if voitCaisse();
      allow create: if voitCaisse();
      allow update, delete: if false;
    }
    // Comité d'aide (au moins 5 personnes) : un document par membre du comité, géré par les administrateurs
    function estComite() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/caisse_comite/$(request.auth.uid));
    }
    match /caisse_comite/{cid} {
      allow read: if isActiveMember() || isAdmin();
      allow write: if isAdmin();
    }
    // Paramètres de la caisse (plafond d'une aide…) : lecture par les membres actifs, écriture par les administrateurs
    match /caisse_config/{pid} {
      allow read: if isActiveMember() || isAdmin();
      allow write: if isAdmin();
    }

    // Demandes d'aide : visibles du membre demandeur, du comité et des administrateurs seulement
    match /aides/{aid} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || estComite() || isAdmin());
      allow create: if isActiveMember() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.statut == 'nouvelle';
      allow update: if isAdmin() || estComite() || gereCaisse();
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.statut == 'nouvelle');
      match /votes/{vid} {
        allow read: if isAdmin() || estComite();
        allow write: if isAdmin() || (estComite() && request.auth.uid == vid);
      }
    }

    // Vie du groupe : naissances, décès, mariages signalés par les membres, publiés après validation d'un administrateur
    match /vie_evenements/{vid} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin() ||
        (resource.data.statut == 'valide' && isActiveMember()));
      allow create: if isActiveMember() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.statut == 'en_attente';
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.statut == 'en_attente');
    }

    // Justificatifs des dépenses : équipe de la caisse seulement
    match /depenses_justificatifs/{did} {
      allow read: if voitCaisse();
      allow write: if gereCaisse();
    }
  }
}
