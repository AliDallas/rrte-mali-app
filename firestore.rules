rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveMember() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.statut == 'actif';
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Profils utilisateurs
    // - lecture : son propre profil, ou tout profil pour un membre actif / un admin
    // - création : uniquement en statut "en_attente" avec le rôle "member"
    // - modification : le membre ne peut pas changer son statut ni son rôle (seul un admin le peut)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isActiveMember() || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.statut == 'en_attente' &&
        request.resource.data.role == 'member';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          request.resource.data.statut == resource.data.statut &&
          request.resource.data.role == resource.data.role) ||
        isAdmin());
      allow delete: if isAdmin();
    }

    // Entreprises & Restaurants : lecture publique, écriture par le propriétaire ou admin
    // Fiches de l'annuaire : lecture par les membres actifs, écriture par les administrateurs
    match /fiches/{ficheId} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
      // un membre peut modifier sa propre fiche (reliée à son compte), sans toucher aux numéros ni au lien
      allow update: if isActiveMember() && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['nom', 'prenom', 'email', 'ville', 'activite', 'competences', 'anciennete', 'reseaux',
           'attentes', 'info', 'pays', 'presentation', 'logo', 'statutFiche', 'aConfirmer']);
    }

    // Entreprises des membres (5 maximum par membre, contrôlé par l'application) : membres actifs uniquement
    match /entreprises/{entId} {
      allow read: if isAdmin() || (isActiveMember() &&
        (resource.data.statut == 'publie' || resource.data.ownerUid == request.auth.uid));
      allow create: if isAdmin() || (isActiveMember() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.statut == 'publie');
      allow update: if isAdmin() || (isActiveMember() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Prestataires recommandés (coiffeur, couturier, plombier…) avec notes et commentaires
    match /prestataires/{pid} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() ||
        (isActiveMember() && resource.data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid) ||
        (isActiveMember() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nbAvis', 'sommeNotes']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /avis/{avisId} {
        allow read: if isActiveMember();
        allow create, update: if isActiveMember() && request.auth.uid == avisId &&
          request.resource.data.uid == request.auth.uid;
        allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == avisId);
      }
    }

    match /businesses/{bizId} {
      allow read: if true;
      allow create: if isActiveMember();
      allow update, delete: if isSignedIn() &&
        (resource.data.owner_uid == request.auth.uid || isAdmin());
    }

    match /restaurants/{restId} {
      allow read: if true;
      allow create: if isActiveMember();
      allow update, delete: if isSignedIn() &&
        (resource.data.owner_uid == request.auth.uid || isAdmin());
    }

    // Événements : lecture réservée aux membres actifs, création/suppression par les admins,
    // inscription : un membre actif peut modifier uniquement la liste "attendees"
    match /events/{eventId} {
      allow read: if isActiveMember();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isActiveMember() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees']));
      allow delete: if isAdmin();
    }

    // Offres d'emploi / Services B2B : réservé aux membres actifs
    match /job_listings/{jobId} {
      allow read, create: if isActiveMember();
      allow update, delete: if isSignedIn() &&
        (resource.data.posted_by == request.auth.uid || isAdmin());
    }

    match /services/{serviceId} {
      allow read, create: if isActiveMember();
      allow update, delete: if isSignedIn() &&
        (resource.data.offered_by == request.auth.uid || isAdmin());
    }

    // Avis / commentaires : lecture réservée aux membres pour l'instant
    match /reviews/{reviewId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember();
      allow update, delete: if isSignedIn() &&
        (resource.data.author_uid == request.auth.uid || isAdmin());
    }

    // Vidéos : visibles une fois approuvées, modération admin
    match /videos/{videoId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isActiveMember();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Logs admin : réservé aux admins
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
